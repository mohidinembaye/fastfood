@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Client
actor "Gérant" as Gerant
actor Livreur
actor "Système Bancaire" as Banque

rectangle "Système de Gestion FastFood" {

    usecase "Se connecter" as UC1

    usecase "Consulter le menu" as UC2
    usecase "Passer une commande" as UC3
    usecase "Payer une commande" as UC4
    usecase "Consulter\nl'historique des commandes" as UC5

    usecase "Ajouter un plat" as UC6
    usecase "Lister les commandes\nen attente" as UC7
    usecase "Valider une commande" as UC8
    usecase "Assigner un livreur" as UC9

    usecase "Sélectionner un ou\nplusieurs plats" as UC10
    usecase "Vérifier la disponibilité\ndes plats" as UC11
    usecase "Calculer le montant" as UC12
    usecase "Enregistrer la commande" as UC13

    usecase "Traiter le paiement" as UC14
    usecase "Générer un reçu" as UC15

    usecase "Notifier le client" as UC16

    usecase "Afficher les livreurs\ndisponibles" as UC17
    usecase "Notifier le livreur" as UC18

}

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC4
Client --> UC5

Gerant --> UC6
Gerant --> UC7
Gerant --> UC8
Gerant --> UC9

Banque --> UC14

Livreur --> UC18

UC3 .> UC10 : <<include>>
UC3 .> UC11 : <<include>>
UC3 .> UC12 : <<include>>
UC3 .> UC13 : <<include>>

UC4 .> UC14 : <<include>>
UC4 .> UC15 : <<include>>

UC8 .> UC16 : <<include>>

UC9 .> UC17 : <<include>>
UC9 .> UC18 : <<include>>

@enduml